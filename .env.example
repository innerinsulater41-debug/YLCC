# ==============================================================================
# YLCC Institutional Web Platform - Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentication & Session Security (HMAC cookie signing)
SESSION_SECRET=ylcc_prod_secure_secret_key_change_me_in_production_2026

# Supabase Integration (Optional - Fallback to local persistent JSON store & public/uploads if omitted)
# Get these from your Supabase project dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
